# Fal.ai API key — https://fal.ai/dashboard/keys
FAL_API_KEY=your_fal_api_key_here

# Private assets Blob store — https://vercel.com/docs/storage/vercel-storage/vercel-blob
# Store id of the private (access: 'private') Blob store used for all M0.2/M0.3
# asset storage. On Vercel, requests to this store authenticate via the
# platform's Vercel OIDC token (system-managed — nothing to set here).
PRIVATE_ASSETS_STORE_ID=your_private_store_id_here

# Optional local/non-OIDC fallback — server-only, sensitive, never prefix with
# NEXT_PUBLIC_. Only needed for local development against the private store
# when a Vercel OIDC token isn't available; production on Vercel uses OIDC.
PRIVATE_ASSETS_READ_WRITE_TOKEN=

# M0.2 closed storage — server-only. Signs short-lived result capability
# tokens for /api/proxy (HMAC-SHA-256, node:crypto). Must be a cryptographically
# random value of at least 32 bytes (e.g. `openssl rand -base64 32`). Never
# prefix with NEXT_PUBLIC_. A missing or short value fails closed.
ASSET_ACCESS_SECRET=your_random_secret_of_at_least_32_bytes

# M0.3 retention/deletion — server-only. Mandatory positive integer number of
# hours an asset group (source/mask/result) may exist before the scheduled
# cleanup deletes it. No safe default is defined here — the Owner must choose
# this value before production activation. Missing, zero, negative,
# fractional or non-integer values fail closed (no asset groups are created).
ASSET_RETENTION_HOURS=

# M0.3 scheduled cleanup — server-only. Bearer secret required to call
# /api/internal/retention. Must be a cryptographically random value of at
# least 32 bytes (e.g. `openssl rand -base64 32`). Never prefix with
# NEXT_PUBLIC_. A missing or short value fails closed. Production Cron
# registration/schedule is a separate Owner decision, out of scope here.
CRON_SECRET=

# Upstash Redis — https://console.upstash.com
# Create a database → REST API → copy URL and token.
# Also available via Vercel Marketplace: vercel.com/marketplace/upstash
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Rate limiting: generations per IP per 24-hour window (defaults shown)
DAILY_LIMIT=3
DAILY_LIMIT_PROFI=20
DAILY_LIMIT_AGENCY=100

# Dev overrides (optional)
# BYPASS_RATE_LIMIT=true        # disable rate limiting completely
# DEV_IPS=127.0.0.1,::1         # IPs that always bypass the limit
